rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(profileId);
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);

      // Messages inside a match
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow update, delete: if false;
      }
    }
  }
}
