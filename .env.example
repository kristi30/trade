# Server-only secret. Never expose this as a VITE_ variable.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional URL for the hosted web app / backend environment.
APP_URL="https://your-web-app.example.com"

# For Android/iOS builds, point this at the deployed HTTPS Express backend.
# Leave blank while using the built-in iPhone local test mode.
VITE_API_BASE_URL=


# Optional: Firebase Cloud Messaging Web Push certificate key.
# Browser notifications work without it while the app is open, but closed-app web push needs this.
VITE_FIREBASE_VAPID_KEY=
